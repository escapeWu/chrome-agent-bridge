{
  "name": "chrome-agent-bridge",
  "version": "0.7.0",
  "description": "A local Chrome Native Messaging to MCP bridge for user-approved browser automation.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node mcp/server.mjs",
    "install-host": "node scripts/install-host.mjs",
    "uninstall-host": "node scripts/uninstall-host.mjs",
    "build:extension": "node scripts/build-extension-zip.mjs",
    "test": "node --test",
    "check": "node --check mcp/server.mjs && node --check native-host/host.mjs && node --check extension/service-worker.js && node --check extension/popup.js && node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/escapeWu/chrome-agent-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/escapeWu/chrome-agent-bridge/issues"
  },
  "homepage": "https://github.com/escapeWu/chrome-agent-bridge#readme"
}
